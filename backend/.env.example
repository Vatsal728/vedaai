# Groq API - get from https://console.groq.com/keys (free, no CC, 30 RPM / 14400 per day)
GROQ_API_KEY=
# Reliable Groq models only (legacy llama-3.1/3.3 retired Aug 16 2026)
GROQ_MODEL_Q=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Groq vision fallback (unused when Gemini enabled)
GROQ_VISION_MODEL=llava-v1.6-34b

# Gemini selective vision for low-confidence handwriting / diagrams (Option B)
# Get from https://aistudio.google.com/app/apikey (free 60 RPM)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
MAX_FILE_SIZE_MB=10
SESSION_TTL_MINUTES=45
TMP_DIR=./tmp/sessions

# OCR + Vision
OCR_USE_GPU=false
# Enable selective Gemini vision for low-confidence handwriting / diagrams (avg conf <0.5 or diagram type)
ENABLE_VISION_FALLBACK=true
